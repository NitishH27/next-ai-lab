# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; never commit real credentials.

# Required. MongoDB Atlas cluster host without embedded credentials.
# Atlas: Database > Connect > Drivers. Use the host part only, for example
# mongodb+srv://<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<cluster>.mongodb.net/?retryWrites=true&w=majority

# Required. Atlas database user and password. Keep them separate from the URI so
# characters such as @, :, /, or ? in the password are not parsed as URI syntax.
MONGODB_USER=<db_user>
MONGODB_PASSWORD=<db_password>

# Optional. Database name. Defaults to jobflow.
MONGODB_DB=jobflow

# Required. Long random secret used by Better Auth.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Required. Base URL of the running app.
BETTER_AUTH_URL=http://localhost:3000
