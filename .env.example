# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; never commit real credentials.

# Required. MongoDB Atlas cluster host without embedded credentials.
# Atlas: Database > Connect > Drivers. Use the host part only, for example
# mongodb+srv://<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<cluster>.mongodb.net/?retryWrites=true&w=majority

# Required. Atlas database user and password. Keep them separate from the URI so
# characters such as @, :, /, or ? in the password are not parsed as URI syntax.
MONGODB_USER=<db_user>
MONGODB_PASSWORD=<db_password>

# Required in deployed environments. Database name. Defaults to jobflow_dev.
# Use jobflow_test for integration tests, jobflow_preview for preview deployments,
# and jobflow_prod for production. Never point production at a non-prod database.
MONGODB_DB=jobflow_dev

# Required. Long random secret used by Better Auth.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Required. Base URL of the running app.
BETTER_AUTH_URL=http://localhost:3000

# Optional locally, required in production. Resend API key used to send
# verification emails. Without it, local development logs the verification link
# to the server console and production sign-up fails loudly.
RESEND_API_KEY=re_your_api_key

# Optional. Sender shown in verification emails. Resend only accepts addresses
# on a verified domain; onboarding@resend.dev works for your own test address.
EMAIL_FROM=JobFlowAI <onboarding@resend.dev>
